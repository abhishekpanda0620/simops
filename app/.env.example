# API Configuration
VITE_API_URL=http://localhost:8000/api

# Data Source: 'backend' or 'local'
# - backend: Fetch data from Laravel API (requires server running)
# - local: Use static frontend data (works offline)
VITE_DATA_SOURCE=local

# Guest Login Credentials (for seeded demo account)
VITE_GUEST_EMAIL=test@example.com
VITE_GUEST_PASSWORD=password
